# StockTalk Frontend Environment Variables
# Copy this file to .env.local (Vite loads .env.local automatically) or .env

# API base URL (FastAPI backend)
VITE_API_URL=http://localhost:8000

# Supabase Auth (public, browser-safe values — find in Supabase Project Settings > API)
# Never expose the Supabase service_role key in frontend code.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
