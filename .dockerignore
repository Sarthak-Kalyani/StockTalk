# Root-level ignore (Docker build context is the repo root)
.git/
.gitignore
frontend/node_modules/
frontend/dist/
*.md

# Backend app directory (build context copies backend/)
backend/__pycache__/
backend/*.py[cod]
backend/.env
backend/.env.example
backend/.pytest_cache/
backend/test.db
backend/stocktalk_dev.db
backend/*.log
backend/.git/
backend/.gitignore
backend/README.md
backend/.dockerignore
