# StockTalk Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME="StockTalk Backend"
DATABASE_URL="sqlite:///./stocktalk_dev.db"

# Supabase Configuration
# Get these from your Supabase Project Settings > API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# Google Cloud Vision (OCR)
# Path to service account JSON file or JSON string
GOOGLE_CLOUD_VISION_CREDENTIALS=""

# Razorpay (Payments) - Test Mode
# Get these from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-test-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_BILLS="bills"
SUPABASE_STORAGE_BUCKET_CHAT="chat-attachments"
SUPABASE_STORAGE_BUCKET_CATALOGUE="catalogue-images"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"